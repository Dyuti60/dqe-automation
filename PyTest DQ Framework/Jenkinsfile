pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DQ_FRAMEWORK_DIR = 'PyTest DQ Framework'
        DQ_VENV = '.venv-dq'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${DQ_FRAMEWORK_DIR}") {
                    sh '''
                        apt-get update
                        apt-get install -y --no-install-recommends \
                            build-essential libpq-dev python3 python3-dev python3-pip python3-venv
                        rm -rf "${DQ_VENV}"
                        python3 -m venv "${DQ_VENV}"
                        . "${DQ_VENV}/bin/activate"
                        python -m pip install --upgrade pip
                        python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Parquet DQ Tests') {
            steps {
                dir("${DQ_FRAMEWORK_DIR}") {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        withCredentials([usernamePassword(
                            credentialsId: 'POSTGRES_SECRET',
                            usernameVariable: 'DQ_DB_USER',
                            passwordVariable: 'DQ_DB_PASSWORD'
                        )]) {
                            sh '''
                                set +x
                                . "${DQ_VENV}/bin/activate"
                                rm -rf html_report
                                python -m pytest tests -c tests/pytest.ini -m "parquet_data" \
                                    --db_host="postgres" \
                                    --db_port="5432" \
                                    --db_name="mydatabase" \
                                    --html=html_report/report.html
                            '''
                        }
                    }
                }
            }
        }

        stage('Archive and Publish Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'PyTest DQ Framework/html_report/**',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'PyTest DQ Framework/html_report',
                    reportFiles: 'report.html',
                    reportName: 'PyTest DQ HTML Report'
                ])
            }
        }
    }

    post {
        always {
            echo 'PyTest DQ pipeline execution completed; review the archived HTML report.'
        }
    }
}
